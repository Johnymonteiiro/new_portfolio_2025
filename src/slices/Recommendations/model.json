{
  "id": "recommendations",
  "type": "SharedSlice",
  "name": "Recommendations",
  "description": "Recommendations section with testimonials from colleagues",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Recommendations"
          }
        }
      },
      "items": {
        "recommender_name": {
          "type": "Text",
          "config": {
            "label": "Name",
            "placeholder": "John Doe"
          }
        },
        "recommender_role": {
          "type": "Text",
          "config": {
            "label": "Role / Title",
            "placeholder": "Fullstack Developer"
          }
        },
        "recommender_photo": {
          "type": "Image",
          "config": {
            "label": "Profile Photo",
            "constraint": {},
            "thumbnails": []
          }
        },
        "recommender_linkedin": {
          "type": "Link",
          "config": {
            "label": "LinkedIn Profile",
            "allowTargetBlank": true
          }
        },
        "recommendation_text": {
          "type": "StructuredText",
          "config": {
            "label": "Recommendation Text",
            "allowTargetBlank": false,
            "single": "paragraph,strong,em"
          }
        }
      }
    }
  ]
}
