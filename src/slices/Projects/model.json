{
  "id": "projects",
  "type": "SharedSlice",
  "name": "Projects",
  "description": "Projects section showcasing portfolio work",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Projects"
          }
        }
      },
      "items": {
        "title": {
          "type": "Text",
          "config": {
            "label": "Project Title",
            "placeholder": "Noria UI Components"
          }
        },
        "description": {
          "type": "Text",
          "config": {
            "label": "Project Description",
            "placeholder": "Short description of the project"
          }
        },
        "category": {
          "type": "Select",
          "config": {
            "label": "Category",
            "options": ["WEB DEVELOPMENT", "UI DESIGN"],
            "default_value": "WEB DEVELOPMENT"
          }
        },
        "thumbnail": {
          "type": "Image",
          "config": {
            "label": "Thumbnail Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "link": {
          "type": "Link",
          "config": {
            "label": "Project Link",
            "allowTargetBlank": true
          }
        },
        "is_recent": {
          "type": "Boolean",
          "config": {
            "label": "Is Recent / Featured",
            "default_value": false,
            "placeholder_true": "Yes",
            "placeholder_false": "No"
          }
        }
      }
    }
  ]
}
