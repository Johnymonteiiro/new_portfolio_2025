{
  "id": "services",
  "type": "SharedSlice",
  "name": "Services",
  "description": "Services section listing what you offer",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "section_title": {
          "type": "Text",
          "config": {
            "label": "Section Title",
            "placeholder": "Service"
          }
        }
      },
      "items": {
        "title": {
          "type": "Text",
          "config": {
            "label": "Service Title",
            "placeholder": "Web Development"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Service Description",
            "allowTargetBlank": false,
            "single": "paragraph,strong,em"
          }
        },
        "icon_type": {
          "type": "Select",
          "config": {
            "label": "Icon Type",
            "options": ["monitor", "pen", "code", "design"],
            "default_value": "monitor"
          }
        },
        "icon_color": {
          "type": "Select",
          "config": {
            "label": "Icon Color",
            "options": ["green", "purple", "gray"],
            "default_value": "green"
          }
        }
      }
    }
  ]
}
