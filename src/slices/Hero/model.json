{
  "id": "hero",
  "type": "SharedSlice",
  "name": "Hero",
  "description": "About / Profile section at the top of the homepage",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "name": {
          "type": "Text",
          "config": {
            "label": "Full Name",
            "placeholder": "João José Sebastião"
          }
        },
        "role": {
          "type": "Text",
          "config": {
            "label": "Role",
            "placeholder": "Software Engineer"
          }
        },
        "tech_stack": {
          "type": "Text",
          "config": {
            "label": "Tech Stack (pipe-separated)",
            "placeholder": "Node.js | Python | React.js"
          }
        },
        "bio": {
          "type": "StructuredText",
          "config": {
            "label": "Bio",
            "allowTargetBlank": true,
            "single": "paragraph,strong,em,hyperlink"
          }
        },
        "quote": {
          "type": "Text",
          "config": {
            "label": "Quote",
            "placeholder": "You don't need to trust me..."
          }
        },
        "profile_image": {
          "type": "Image",
          "config": {
            "label": "Profile Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "available": {
          "type": "Boolean",
          "config": {
            "label": "Available for work",
            "default_value": true,
            "placeholder_true": "Yes",
            "placeholder_false": "No"
          }
        },
        "email_url": {
          "type": "Link",
          "config": {
            "label": "Email / Contact URL",
            "allowTargetBlank": true
          }
        },
        "instagram_url": {
          "type": "Link",
          "config": {
            "label": "Instagram URL",
            "allowTargetBlank": true
          }
        },
        "linkedin_url": {
          "type": "Link",
          "config": {
            "label": "LinkedIn URL",
            "allowTargetBlank": true
          }
        },
        "github_url": {
          "type": "Link",
          "config": {
            "label": "GitHub URL",
            "allowTargetBlank": true
          }
        },
        "resume_url": {
          "type": "Link",
          "config": {
            "label": "Resume / CV URL",
            "allowTargetBlank": true
          }
        }
      },
      "items": {
        "interest_title": {
          "type": "Text",
          "config": {
            "label": "Interest Title",
            "placeholder": "SaaS"
          }
        },
        "interest_description": {
          "type": "Text",
          "config": {
            "label": "Interest Description",
            "placeholder": "Short description of this interest area"
          }
        },
        "interest_icon": {
          "type": "Select",
          "config": {
            "label": "Interest Icon",
            "options": ["saas", "ai", "innovation"],
            "default_value": "saas"
          }
        }
      }
    }
  ]
}
